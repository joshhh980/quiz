QUIZ_AUTH_USER=host
QUIZ_AUTH_PASSWORD=replace-this-with-a-unique-password-of-at-least-8-characters
# Set DATABASE_URL to the Render Postgres internal connection URL to store quiz state in Postgres.
# Render also provides the database URL through the service environment.
# DATABASE_SSL=false
# On Render, set this in the service environment if a persistent disk is mounted:
# QUIZ_STATE_FILE=/var/data/.quiz-state.json
